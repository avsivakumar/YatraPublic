{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Yatra": {
    "InboundQueueCapacity": 100,
    "OutboundQueueCapacity": 100,
    "PendingReplyLifetimeMinutes": 30,
    "PendingReplyTerminalRetentionMinutes": 30,
    "PendingReplyCleanupSeconds": 60,
    "SseHeartbeatSeconds": 15,
    "StreamChannelCapacity": 100,
    "AllowedCorsOrigins": [
      "http://localhost:5173"
    ]
  }
}